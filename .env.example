# Copy this file to credentials/.env and fill in real values (see env_config.py).
# credentials/ is git-ignored - never commit the real file.
# Format: plain KEY=VALUE lines, '#' comments.

# --- 1C:Enterprise thin client (launch_1c.py, lib1c.py) ---
1c_login=your_1c_user
1c_password=your_1c_password
# Web-published infobase, as registered in %APPDATA%\1C\1CEStart\ibases.v8i
1c_connection_string=ws=https://your-1c-server.example/your_infobase;
# Company-specific part of the 1C main window title ("<this> / Управление торговлей")
1c_window_title_hint=
# Optional: full path to 1cv8c.exe if 1C is installed somewhere non-standard
1c_thin_client=

# --- Alif Business merchant portal (alif_client.py), one login per tenant ---
ALIF_BUSINESS_BASE_URL=https://business.alif.uz
alifshop_login=your_phone_digits_without_country_code
alifshop_password=your_password
alif_moliya_login=your_phone_digits_without_country_code
alif_moliya_password=your_password

# --- Uzum Nasiya merchant portal (uzum_client.py) ---
UZUM_NASIYA_BASE_URL=https://merchant.uzumnasiya.uz
uzum_nasiya_login=your_company_id
uzum_nasiya_password=your_password

# --- Google Sheets (sheets_client.py, alif_sheets_client.py, report_sheet.py) ---
# Service-account key goes to credentials/service_account.json
IMAN_SPREADSHEET_ID=your_iman_sverka_spreadsheet_id
IMAN_WORKSHEET_NAME=IMANUM STORE
ALIF_SPREADSHEET_ID=your_alif_nasiya_spreadsheet_id
ALIF_WORKSHEET_GID=0
COMMISSIONS_SPREADSHEET_ID=your_commissions_spreadsheet_id
COMMISSIONS_WORKSHEET_GID=0
# Live per-run report sheet: full sheet URL or bare spreadsheet id
REPORT_SPREADSHEET_URL=your_report_spreadsheet_id

# --- Telegram log relay (telegram_logger.py) - optional ---
logs_bot_token=123456:your-bot-token-from-BotFather
telegram_group_id=-123456789
# Telegram @username (without @) tagged when a run pauses for a decision
mention_username=your_telegram_username
